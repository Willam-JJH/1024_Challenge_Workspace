          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "kind",
          "status",
          "created_at"
        ],
        "title": "EnrollmentOut"
      },
      "MyEnrollmentOut": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "event_slug": {
            "type": "string",
            "title": "Event Slug"
          },
          "event_name": {
            "type": "string",
            "title": "Event Name"
          },
          "starts_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts At"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "event_slug",
          "event_name",
          "kind",
          "status",
          "created_at"
        ],
        "title": "MyEnrollmentOut"
      },
      "MyEnrollmentsOut": {
        "properties": {
          "enrollments": {
            "items": {
              "$ref": "#/components/schemas/MyEnrollmentOut"
            },
            "type": "array",
            "title": "Enrollments"
          }
        },
        "type": "object",
        "required": [
