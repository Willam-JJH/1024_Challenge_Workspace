            "title": "Registration Open"
          },
          "voting_open": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voting Open"
          },
          "company_seats": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Seats"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "title": "EventCreateIn"
      }
    }
  }
}
