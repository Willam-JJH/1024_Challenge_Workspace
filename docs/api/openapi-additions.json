            "title": "Live Version"
          },
          "competition_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Competition Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "company_id",
          "company_name",
          "company_slug",
          "title",
          "summary",
          "awards",
          "live_version",
          "competition_version"
