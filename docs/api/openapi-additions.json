{
  "_comment": "只在 Go 侧实现的接口。导出脚本会把这份覆盖层并进 openapi.json，保证重新从 Python 导出时新接口不会丢。Python 实现已进入退场流程，这些能力不再在 Python 侧实现。",
  "paths": {
    "/api/v1/exhibition/archive": {
      "get": {
        "tags": [
          "exhibition"
        ],
        "summary": "往届列表（已收口的赛事）",
        "operationId": "list_archived_events_api_v1_exhibition_archive_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ArchivedEventOut"
                  },
                  "type": "array",
                  "title": "Response List Archived Events"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exhibition/archive/{event_id}": {
      "get": {
        "tags": [
          "exhibition"
        ],
        "summary": "某一届的往届作品与获奖",
        "operationId": "get_archived_event_api_v1_exhibition_archive__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveDetailOut"
                }
              }
            }
          },
          "404": {
            "description": "该届尚未收口，作品仍在进行中的页面上"
          }
        }
      }
    },
    "/api/v1/events/{event_id}/enrollments": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "报名参加某一届（参赛者 / 观众）",
        "operationId": "create_enrollment_api_v1_events__event_id__enrollments_post",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentOut"
                }
              }
            }
          },
          "404": {
            "description": "赛事不存在"
          },
          "409": {
            "description": "报名未开放、赛事已结束或已收口、仍在公司中"
          },
          "422": {
            "description": "身份取值不合法"
          }
        }
      }
    },
    "/api/v1/events/{event_id}/enrollments/me": {
      "delete": {
        "tags": [
          "events"
        ],
        "summary": "取消报名（开赛前）",
        "operationId": "withdraw_enrollment_api_v1_events__event_id__enrollments_me_delete",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkOut"
                }
              }
            }
          },
          "404": {
            "description": "赛事不存在或尚未报名"
          },
          "409": {
            "description": "赛事已开始或仍在公司中"
          }
        }
      }
    },
    "/api/v1/me/enrollments": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "我的报名记录",
        "operationId": "my_enrollments_api_v1_me_enrollments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyEnrollmentsOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/event/enrollments": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "当期赛事报名名单",
        "operationId": "admin_enrollments_api_v1_admin_event_enrollments_get",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminEnrollmentOut"
                  },
                  "type": "array",
                  "title": "Response Admin Enrollments"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/events": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "新建下一届赛事",
        "operationId": "create_event_api_v1_admin_events_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreateIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventOut"
                }
              }
            }
          },
          "409": {
            "description": "赛事标识已存在"
          },
          "422": {
            "description": "字段不合法"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnrollmentIn": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "participant",
              "audience"
