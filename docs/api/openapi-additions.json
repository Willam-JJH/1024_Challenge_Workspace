            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "title"
        ],
        "title": "ArchiveAwardOut"
      },
      "ArchiveProjectOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "company_id": {
            "type": "string",
            "title": "Company Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "company_slug": {
            "type": "string",
            "title": "Company Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "awards": {
            "items": {
              "$ref": "#/components/schemas/ArchiveAwardOut"
            },
            "type": "array",
            "title": "Awards"
          },
          "live_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
