# 基础设施环境变量（复制为 .env.infra，勿提交）
# 供 scripts/cf_provision.py、scripts/cf_firewall.sh 读取；compose 不读这个文件。
DOMAIN=example.com
# 源站公网 IP：cf_provision.py 用它建 A 记录
SERVER_IP=203.0.113.10
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_ZONE_ID=replace-me
# 权限：Zone:Read、DNS:Edit、SSL and Certificates:Edit，Zone Resources 限定到本域名
CLOUDFLARE_API_TOKEN=replace-me

ACME_EMAIL=you@example.com
# origin = Cloudflare 橙云 + Origin CA；auto = Let's Encrypt
TLS_MODE=origin
