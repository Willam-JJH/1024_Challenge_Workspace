# 生产环境变量：复制为 .env.prod（已在 .gitignore 中排除）
#
#   cp infra/.env.prod.example infra/.env.prod
#   chmod 600 infra/.env.prod
#
# 这份文件里只有变量名与占位符；真实值只写进 .env.prod，不进仓库。

# 站点域名。只用于 CORS、公开地址与邮件链接——TLS 由 Cloudflare 终止，
# 源站不再申请证书。
DOMAIN=example.com

# Cloudflare Zero Trust → Networks → Tunnels 里复制。空值时 cloudflared 起不来。
CLOUDFLARE_TUNNEL_TOKEN=

# go-api 镜像标签。本机构建后 compose 会给它打上这个名字，migrate 服务也用同一个。
GO_API_IMAGE=challenge-go-api:local
# 国内网络构建可换成 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=challenge

# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_BOT_CHECK_SECRET=

# 当期赛事。换届时改这里并重启 go-api，详见 docs/design/season-lifecycle.md
APP_CURRENT_EVENT_SLUG=1024-challenge
# 比赛结束多少天后收口（作品进前序作品、报名投票关闭、身份回落）
APP_SEASON_CLOSE_AFTER_DAYS=30
# 素材总占用上限（字节），0 = 不限制
APP_UPLOAD_QUOTA_BYTES=0
# 全域每 IP 每秒请求上限（0 = 关闭）
APP_RATE_LIMIT_RPS=50

# 邮件投递：console（只写日志）或 smtp
APP_MAIL_DRIVER=console
APP_MAIL_FROM=
APP_MAIL_FROM_NAME=1024 Challenge
APP_SMTP_HOST=
APP_SMTP_PORT=465
APP_SMTP_TLS=ssl
APP_SMTP_USER=
# Gmail 填「应用专用密码」，QQ/163 填授权码；都不要用登录密码
APP_SMTP_PASSWORD=
