# 生产环境变量：复制为 .env.prod（已在 .gitignore 中排除）
DOMAIN=example.com

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=challenge

# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_BOT_CHECK_SECRET=change-me

# 邮件投递：console（只写日志）或 smtp
APP_MAIL_DRIVER=console
APP_MAIL_FROM=no-reply@example.com
APP_MAIL_FROM_NAME=1024 Challenge
APP_SMTP_HOST=smtp.example.com
APP_SMTP_PORT=465
APP_SMTP_TLS=ssl
APP_SMTP_USER=no-reply@example.com
# Gmail 填「应用专用密码」，QQ/163 填授权码；都不要用登录密码
APP_SMTP_PASSWORD=change-me
