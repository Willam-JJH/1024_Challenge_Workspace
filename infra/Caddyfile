# 生产入口：Cloudflare Tunnel → cloudflared → Caddy(:80，仅在 compose 网络内)
#
# 这里不做 TLS：证书由 Cloudflare 边缘终止，cloudflared 到 Caddy 走 compose 内网。
# Caddy 不再暴露任何端口，所以「绕过 Cloudflare 直连源站」在拓扑上就不成立，
# go-api 也因此可以固定 APP_BEHIND_CLOUDFLARE=true。
:80 {
	encode zstd gzip

	# OAuth 元数据必须挂在站点根
	handle /.well-known/* {
		reverse_proxy go-api:8000
	}

	handle /api/* {
		reverse_proxy go-api:8000
	}

	handle /v1/* {
		reverse_proxy go-api:8000
	}

	handle {
		# 前端重设计完成后，换成静态目录或前端容器
		respond "frontend not deployed yet" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
